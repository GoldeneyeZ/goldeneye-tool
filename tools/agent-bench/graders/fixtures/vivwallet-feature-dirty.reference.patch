+    @Test
+    public void should_summarize_payments_between_inclusive_bounds() {
+        //Given
+        Payment before = Payment.builder().id(1L).date(LocalDate.of(2020, Month.JANUARY, 31)).viv(10).build();
+        Payment first = Payment.builder().id(2L).date(LocalDate.of(2020, Month.FEBRUARY, 1)).viv(20).build();
+        Payment last = Payment.builder().id(3L).date(LocalDate.of(2020, Month.MARCH, 31)).viv(30).build();
+        Payment after = Payment.builder().id(4L).date(LocalDate.of(2020, Month.APRIL, 1)).viv(40).build();
+        when(paymentRepository.getAllByOrderByDateDesc()).thenReturn(List.of(after, last, first, before));
+        PaymentService paymentService = new PaymentService(userRepository, paymentRepository, actionRepository);
+
+        //When
+        PaymentsSummaryDto summary = paymentService.summarize(LocalDate.of(2020, Month.FEBRUARY, 1),
+                                                              LocalDate.of(2020, Month.MARCH, 31));
+
+        //Then
+        assertThat(summary.getCount()).isEqualTo(2);
+        assertThat(summary.getTotalViv()).isEqualTo(50);
+        assertThat(summary.getTotalAmount()).isEqualByComparingTo(BigDecimal.valueOf(250));
+    }
+
