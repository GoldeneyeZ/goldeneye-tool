+    public PaymentsSummaryDto summarize(LocalDate from, LocalDate to) {
+        List<Payment> payments = getAll().stream()
+                                         .filter(payment -> from == null || !payment.getDate().isBefore(from))
+                                         .filter(payment -> to == null || !payment.getDate().isAfter(to))
+                                         .collect(Collectors.toList());
+        int totalViv = payments.stream()
+                               .mapToInt(Payment::getViv)
+                               .sum();
+        return PaymentsSummaryDto.builder()
+                                 .count(payments.size())
+                                 .totalViv(totalViv)
+                                 .totalAmount(VivAmounts.toEuros(totalViv))
+                                 .build();
+    }
+
