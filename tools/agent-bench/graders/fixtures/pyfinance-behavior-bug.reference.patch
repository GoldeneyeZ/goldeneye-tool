@@ -21,6 +21,19 @@ def _canonical_column_name(column: object) -> str:
     return _COLUMN_ALIASES.get(name, name.replace(" ", "_"))
 
 
+def _local_naive_timestamp(value: object) -> pd.Timestamp:
+    timestamp = pd.Timestamp(value)
+    if timestamp.tzinfo is not None:
+        # Keep the wall-clock date of the row's own timezone; converting to UTC
+        # would move midnight bars of non-UTC exchanges onto another day.
+        timestamp = timestamp.tz_localize(None)
+    return timestamp
+
+
+def _local_naive_dates(values: pd.Series) -> pd.Series:
+    return pd.to_datetime(values.map(_local_naive_timestamp))
+
+
 def normalize_price_frame(frame: pd.DataFrame) -> pd.DataFrame:
