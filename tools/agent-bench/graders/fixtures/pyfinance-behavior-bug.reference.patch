diff --git a/tests/test_data.py b/tests/test_data.py
index c243166..9f90837 100644
--- a/tests/test_data.py
+++ b/tests/test_data.py
@@ -54,6 +54,54 @@ def test_normalize_price_frame_rejects_missing_adjusted_close() -> None:
         normalize_price_frame(frame)
 
 
+def _price_rows(rows: list[tuple[object, str]]) -> pd.DataFrame:
+    return pd.DataFrame(
+        {
+            "date": [row_date for row_date, _symbol in rows],
+            "symbol": [symbol for _row_date, symbol in rows],
+            "open": 1.0,
+            "high": 1.0,
+            "low": 1.0,
+            "close": 1.0,
+            "adj_close": 1.0,
+            "volume": 100,
+        }
+    )
+
+
+def test_normalize_price_frame_keeps_local_calendar_date_of_offset_dates() -> None:
+    frame = _price_rows(
+        [
+            ("2024-03-08 00:00:00-05:00", "SPY"),
+            ("2024-03-11 00:00:00-04:00", "SPY"),
+            ("2024-01-02 00:00:00+01:00", "MC.PA"),
+            ("2024-04-02 00:00:00+02:00", "MC.PA"),
+        ]
+    )
+
+    prices = normalize_price_frame(frame)
+
+    assert prices["date"].dt.tz is None
+    assert prices["date"].tolist() == [
+        pd.Timestamp("2024-01-02"),
+        pd.Timestamp("2024-04-02"),
+        pd.Timestamp("2024-03-08"),
+        pd.Timestamp("2024-03-11"),
+    ]
+
+
+def test_normalize_price_frame_keeps_local_calendar_date_of_tz_aware_column() -> None:
+    frame = _price_rows([("2024-01-02", "MC.PA"), ("2024-01-03", "MC.PA")])
+    frame["date"] = pd.to_datetime(frame["date"]).dt.tz_localize("Europe/Paris")
+
+    prices = normalize_price_frame(frame)
+
+    assert prices["date"].tolist() == [
+        pd.Timestamp("2024-01-02"),
+        pd.Timestamp("2024-01-03"),
+    ]
+
+
