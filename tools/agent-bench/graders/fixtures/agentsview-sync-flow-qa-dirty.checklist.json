      "all": [
        "\\bcollectAndBatch\\b",
        "\\bwriteIncremental\\b|\\bwriteBatch\\b",
        "\\bWriteSessionIncremental\\b|\\bUpsertSession\\b|\\bInsertMessages\\b"
