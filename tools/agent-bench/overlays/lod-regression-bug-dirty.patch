new file mode 100644
index 0000000..e1fcde6
--- /dev/null
+++ b/src/lod/datasets/expansion/naming.py
@@ -0,0 +1,25 @@
+"""Naming shared by the synthetic expansion generators.
+
+Each generated fixture hashes its labels and identifiers under one namespace,
+so a generator version, seed, split and position always reproduce the same row.
+"""
+
+import uuid
+
+DEFAULT_SEED = 20260910
+SPLITS = ("train", "validation", "test")
+
+
+def scoped(version, split, index, seed=DEFAULT_SEED):
+    """Return the ``version:seed:split:index`` namespace of one fixture."""
+    return f"{version}:{seed}:{split}:{index}"
+
+
+def uuid7_like(hex_digits):
+    """Format 32 hex digits as a UUID carrying version 7 and RFC 4122 variant bits.
+
+    The result is syntactically valid only; its timestamp field is not a time.
+    """
+    digits = list(hex_digits[:32])
+    digits[12], digits[16] = "7", "a"
+    return str(uuid.UUID("".join(digits)))
