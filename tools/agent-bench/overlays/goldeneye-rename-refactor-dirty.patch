diff --git a/crates/application/goldeneye-edit/tests/revalidated_path.rs b/crates/application/goldeneye-edit/tests/revalidated_path.rs
new file mode 100644
index 0000000..6d2be8a
--- /dev/null
+++ b/crates/application/goldeneye-edit/tests/revalidated_path.rs
@@ -0,0 +1,27 @@
+use std::fs;
+use std::path::PathBuf;
+
+use goldeneye_edit::path_auth::{PathAuthorizer, PathIntent};
+
+#[test]
+fn revalidated_update_destination_is_the_canonical_file() {
+    let temporary = tempfile::tempdir().expect("create fixture root");
+    let project = temporary.path().join("project");
+    fs::create_dir_all(project.join("src")).expect("create project fixture");
+    fs::write(project.join("src").join("lib.rs"), "fn existing() {}\n")
+        .expect("write source fixture");
+    let expected: PathBuf = fs::canonicalize(&project)
+        .expect("canonicalize project fixture")
+        .join("src")
+        .join("lib.rs");
+
+    let authorized = PathAuthorizer::new([temporary.path()])
+        .expect("configure allowed root")
+        .authorize(&project, "src/lib.rs", PathIntent::Update)
+        .expect("authorize existing file");
+    let revalidated = authorized.revalidate().expect("revalidate existing file");
+
+    assert_eq!(revalidated.as_path(), expected.as_path());
+    assert_eq!(revalidated.as_path(), authorized.destination());
+    assert_eq!(revalidated.into_path_buf(), expected);
+}
