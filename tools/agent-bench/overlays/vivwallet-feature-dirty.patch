@@ -0,0 +1,20 @@
+package com.invivoo.vivwallet.api.domain.payment;
+
+import java.math.BigDecimal;
+
+/**
+ * Conversions between vivs and euros. Keep the rate here: nothing else should
+ * multiply by it directly.
+ */
+public final class VivAmounts {
+
+    public static final int EUROS_PER_VIV = 5;
+
+    private VivAmounts() {
+    }
+
+    public static BigDecimal toEuros(int viv) {
+        return BigDecimal.valueOf((long) viv * EUROS_PER_VIV);
+    }
+
+}
