@@ -0,0 +1,22 @@
+package com.invivoo.vivwallet.api.domain.payment;
+
+import org.junit.Test;
+
+import java.math.BigDecimal;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class VivAmountsTest {
+
+    @Test
+    public void should_convert_vivs_to_euros() {
+        assertThat(VivAmounts.toEuros(50)).isEqualByComparingTo(BigDecimal.valueOf(250));
+    }
+
+    @Test
+    public void should_convert_zero_and_negative_vivs() {
+        assertThat(VivAmounts.toEuros(0)).isEqualByComparingTo(BigDecimal.ZERO);
+        assertThat(VivAmounts.toEuros(-20)).isEqualByComparingTo(BigDecimal.valueOf(-100));
+    }
+
+}
