diff --git a/ViV-Wallet-api/src/test/java/com/invivoo/vivwallet/api/domain/payment/VivAmountsTest.java b/ViV-Wallet-api/src/test/java/com/invivoo/vivwallet/api/domain/payment/VivAmountsTest.java
