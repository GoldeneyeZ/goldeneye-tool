+// ignored by handleEvent.
+const watchedEventOps = fsnotify.Write |
+	fsnotify.Create |
+	fsnotify.Remove |
+	fsnotify.Rename
+
 type RecursiveWatchResult struct {
 	Watched             int
 	Unwatched           int
@@ -195,10 +204,7 @@ func (w *Watcher) loop() {
