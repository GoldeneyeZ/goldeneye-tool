diff --git a/internal/sync/transient_paths.go b/internal/sync/transient_paths.go
new file mode 100644
index 00000000..062d54a8
--- /dev/null
+++ b/internal/sync/transient_paths.go
@@ -0,0 +1,48 @@
+package sync
+
+import (
+	"path/filepath"
+	"strings"
+)
+
+// transientPathSuffixes are file-name suffixes of editor swap files and
+// atomic-write temp files. A changed path whose base name ends in one of
+// them is never a session source: the writer either renames it onto the
+// real file (which raises its own event) or deletes it.
+var transientPathSuffixes = []string{".tmp", ".swp", ".swx", "~"}
+
+// transientPathNames are exact base names that are never session sources.
+var transientPathNames = []string{".DS_Store"}
+
+// dropTransientPaths returns paths without the entries isTransientPath
+// reports as transient, preserving order. The input slice is not
+// modified.
+func dropTransientPaths(paths []string) []string {
+	kept := make([]string, 0, len(paths))
+	for _, p := range paths {
+		if isTransientPath(p) {
+			continue
+		}
+		kept = append(kept, p)
+	}
+	return kept
+}
+
+// isTransientPath reports whether path names an editor swap file, an
+// atomic-write temp file, or a desktop metadata file. Only the base name
+// is inspected, so a session stored under a directory with such a name
+// is unaffected.
+func isTransientPath(path string) bool {
+	base := filepath.Base(path)
+	for _, name := range transientPathNames {
+		if base == name {
+			return true
+		}
+	}
+	for _, suffix := range transientPathSuffixes {
+		if strings.HasSuffix(base, suffix) {
+			return true
+		}
+	}
+	return false
+}
